generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  password          String
  mobileNumber      String?               @unique
  isActive          Boolean               @default(true)
  profilePhoto      String?
  role              Role                  @default(CANDIDATE)
  lastLogin         DateTime?
  createdAt         DateTime              @default(now())
  attempts          Attempt[]
  sessions          Session[]
  goal              UserGoal?
  bookmarks         Bookmark[]
  collections       BookmarkCollection[]
  practiceLogs      BookmarkPracticeLog[]
  preferredLanguage Language              @default(EN)
  translations      QuestionTranslation[] @relation("Translator")
  reviews           QuestionTranslation[] @relation("Reviewer")
  edits             TranslationRevision[]
  practiceSessions  PracticeSession[]
  aiLogs            AIRequestLog[]
  notifications     Notification[]

  readingProgress    ReadingProgress[]
  readingHistory     ReadingHistory[]
  readingSessions    ReadingSession[]
  studyBookmarks     StudyBookmark[]
  studyHighlights    StudyHighlight[]
  readingNotes       ReadingNote[]
  vocabularyWords    VocabularyWord[]
  flashcards         Flashcard[]
  readingCollections ReadingCollection[]
  studyChats         StudyChat[]
  studyDrafts        AIGeneratedStudyDraft[]
  questionCollections QuestionCollection[]
  questionFavorites   QuestionFavorite[]
  questionRecents     QuestionRecent[]
  questionActivityLogs QuestionActivityLog[]
  questionViews       QuestionView[]
}

model OtpVerification {
  id              String   @id @default(cuid())
  mobileNumber    String   @unique
  otpHash         String
  expiresAt       DateTime
  attempts        Int      @default(0)
  resendCount     Int      @default(0)
  lastRequestedAt DateTime @default(now())
}

enum QuizStatus {
  Draft
  Scheduled
  Live
  Completed
  Archived
}

enum QuestionStatus {
  Draft
  Review
  Approved
  Published
  Rejected
}

model Quiz {
  id                        String          @id @default(cuid())
  title                     String
  description               String?
  duration                  Int
  startDate                 DateTime?
  endDate                   DateTime?
  timezone                  String?         @default("Asia/Kolkata")
  status                    QuizStatus      @default(Draft)
  resumeAllowed             Boolean         @default(true)
  availabilityMode          String          @default("IMMEDIATE")
  hideUntilStart            Boolean         @default(false)
  autoCloseAfterEnd         Boolean         @default(false)
  isDeleted                 Boolean         @default(false)
  deletedAt                 DateTime?
  updatedAt                 DateTime?       @updatedAt
  createdAt                 DateTime        @default(now())
  isPractice                Boolean         @default(false)
  availableLanguages        Language[]      @default([EN])
  attempts                  Attempt[]
  questions                 Question[]
  sections                  Section[]
  bookmarks                 Bookmark[]
  // Proctoring configuration (Phase 19)
  proctorEnabled            Boolean         @default(false)
  proctorWebcam             Boolean         @default(false)
  proctorFace               Boolean         @default(false)
  proctorCopy               Boolean         @default(false)
  proctorPaste              Boolean         @default(false)
  proctorDevTools           Boolean         @default(false)
  proctorMicrophone         Boolean         @default(false)
  proctorIdle               Boolean         @default(false)
  proctorRightClick         Boolean         @default(false)
  proctorMaxTabSwitches     Int             @default(3)
  proctorMaxFsExits         Int             @default(3)
  proctorMaxFaceMissingSecs Int             @default(30)
  proctorWarningLimit       Int             @default(5)
  proctorViolationAction    ViolationAction @default(WARN)
  proctorAutoSubmit         Boolean         @default(false)
}

model Question {
  id                String                    @id @default(cuid())
  quizId            String? // Optional banaya taaki question bina quiz ke bank mein reh sake
  sectionId         String? // Associated section
  question          String
  optionA           String
  optionB           String
  optionC           String
  optionD           String
  correctAnswer     String
  explanation       String?
  subject           String? // Naya: Filter ke liye
  chapter           String? // Naya: Filter ke liye
  topic             String? // Naya: Filter ke liye
  isBank            Boolean                   @default(false) // Naya: Master bank identify karne ke liye
  version           Int                       @default(1)
  status            QuestionStatus            @default(Draft)
  tags              String[]                  @default([])
  isDeleted         Boolean                   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime                  @default(now())
  answers           Answer[]
  revisions         QuestionRevision[]
  comments          ReviewComment[]
  quiz              Quiz?                     @relation(fields: [quizId], references: [id])
  section           Section?                  @relation(fields: [sectionId], references: [id])
  folderId          String?
  folder            Folder?                   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  difficulty        Difficulty                @default(MEDIUM)
  bookmarks         Bookmark[]
  practiceQuestions PracticeSessionQuestion[]
  translations      QuestionTranslation[]

  properties        QuestionPropertyValue[]
  sourceRelations   QuestionRelation[] @relation("SourceQuestion")
  targetRelations   QuestionRelation[] @relation("TargetQuestion")
  collectionItems   QuestionCollectionItem[]
  favorites         QuestionFavorite[]
  recentViews       QuestionRecent[]
  activityLogs      QuestionActivityLog[]

  @@index([quizId, isDeleted])
  @@index([isBank, isDeleted])
  @@index([subject, chapter, topic])
  @@index([sectionId])
  @@index([folderId])
}

model ReviewComment {
  id         String   @id @default(cuid())
  questionId String
  comment    String
  authorName String   @default("Reviewer")
  createdAt  DateTime @default(now())

  questionRelation Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionRevision {
  id            String         @id @default(cuid())
  questionId    String
  version       Int
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  subject       String?
  chapter       String?
  topic         String?
  status        QuestionStatus @default(Draft)
  tags          String[]       @default([])
  createdAt     DateTime       @default(now())
  difficulty    Difficulty     @default(MEDIUM)

  questionRelation Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Section {
  id               String   @id @default(cuid())
  quizId           String
  name             String
  description      String?
  instructions     String?
  order            Int      @default(0)
  marks            Float    @default(4.0)
  negativeMarks    Float    @default(1.0)
  shuffleQuestions Boolean  @default(false)
  shuffleOptions   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Attempt {
  id          String                @id @default(cuid())
  userId      String
  quizId      String
  score       Float
  percentage  Float
  submittedAt DateTime              @default(now())
  completed   Boolean               @default(true)
  state       SessionState          @default(STARTED)
  answers     Answer[]
  quiz        Quiz                  @relation(fields: [quizId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  session     AttemptSession?
  historyLogs SessionHistoryLog[]
  violations  ProctoringViolation[]

  @@index([userId])
  @@index([quizId])
}

model Answer {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean
  timeSpent      Int
  attempt        Attempt  @relation(fields: [attemptId], references: [id])
  question       Question @relation(fields: [questionId], references: [id])

  @@index([attemptId])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  userName  String   @default("System")
  ipAddress String?
  userAgent String?
  action    String
  target    String?

  @@index([timestamp])
  @@index([userId])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderHierarchy")
  questions Question[]
}

enum Role {
  ADMIN
  CANDIDATE
}

model Media {
  id           String   @id @default(cuid())
  fileName     String   @unique
  originalName String
  mimeType     String
  fileSize     Int
  width        Int
  height       Int
  uploadedBy   String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailOtpVerification {
  id              String   @id @default(cuid())
  email           String   @unique
  otpHash         String
  expiresAt       DateTime
  attempts        Int      @default(0)
  resendCount     Int      @default(1)
  lastRequestedAt DateTime @default(now())
  createdAt       DateTime @default(now())
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model UserGoal {
  id                   String  @id @default(cuid())
  userId               String  @unique
  targetAccuracy       Float   @default(75.0)
  weeklyPracticeGoal   Int     @default(5)
  monthlyTestGoal      Int     @default(15)
  questionsPerWeekGoal Int     @default(100)
  isEnabled            Boolean @default(true)

  dailyReadingMinutes   Int @default(30)
  weeklyReadingMinutes  Int @default(210)
  monthlyReadingMinutes Int @default(900)
  pagesGoal             Int @default(10)
  wordsGoal             Int @default(2500)
  vocabularyGoal        Int @default(5)
  booksGoal             Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BookmarkStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
  ARCHIVED
}

model BookmarkCollection {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int        @default(0)
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  bookmarks   Bookmark[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Bookmark {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  quizId         String? // Originating Test ID
  timesPracticed Int       @default(0)
  lastPracticed  DateTime?
  correctCount   Int       @default(0)
  incorrectCount Int       @default(0)

  // Spaced Repetition / Revision Scheduling
  nextRevisionDate   DateTime?
  revisionCount      Int       @default(0)
  lastRevisionResult Boolean?
  lastRevisionAt     DateTime?

  status BookmarkStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections BookmarkCollection[]

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quiz     Quiz?    @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@unique([userId, questionId])
  @@index([userId, status])
}

model BookmarkPracticeLog {
  id             String   @id @default(cuid())
  userId         String
  questionsCount Int
  correctCount   Int
  score          Float
  timeSpent      Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PracticeSource {
  BOOKMARKS
  INCORRECT
  SKIPPED
  WEAK_SUBJECTS
  WEAK_CHAPTERS
  WEAK_TOPICS
  MIXED
  CUSTOM
}

model PracticeSession {
  id             String         @id @default(cuid())
  userId         String
  source         PracticeSource
  filters        Json?
  adaptive       Json?
  options        Json? // For shuffle, timer, instant feedback, explanation, negative marking, etc.
  createdAt      DateTime       @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  currentIndex   Int            @default(0)
  totalQuestions Int
  score          Float?
  accuracy       Float?
  timeSpent      Int            @default(0)
  state          SessionState   @default(STARTED)

  questions   PracticeSessionQuestion[]
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot    PracticeSessionSnapshot?
  historyLogs SessionHistoryLog[]

  @@index([userId])
  @@index([state])
}

model PracticeSessionQuestion {
  id                String   @id @default(cuid())
  practiceSessionId String
  questionId        String
  selectedAnswer    String? // Track response selection
  isCorrect         Boolean?
  timeSpent         Int      @default(0)
  order             Int      @default(0)

  practiceSession PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceSessionId, questionId])
}

enum SessionState {
  CREATED
  STARTED
  ACTIVE
  OFFLINE
  PAUSED
  RESUMED
  LOCKED
  SYNC_CONFLICT
  COMPLETED
  AUTO_SUBMITTED
  EXPIRED
}

enum SessionEvent {
  STARTED
  RESUMED
  AUTO_SAVE
  HEARTBEAT
  OFFLINE
  ONLINE
  CLAIMED
  AUTO_SUBMITTED
  COMPLETED
  EXPIRED
}

model AttemptSession {
  id               String  @id @default(cuid())
  attemptId        String  @unique
  currentIndex     Int     @default(0)
  currentSectionId String?
  questionOrder    Json // Shuffled array of question IDs
  optionOrder      Json // Shuffled options map per question
  markedForReview  Json // Array of marked question IDs
  visitedQuestions Json // Array of visited question IDs
  warningCount     Int     @default(0)
  version          Int     @default(0)

  lastHeartbeatAt DateTime?
  clientId        String? // Client active tab token
  updatedAt       DateTime  @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model PracticeSessionSnapshot {
  id               String    @id @default(cuid())
  practiceId       String    @unique
  currentIndex     Int       @default(0)
  currentSectionId String?
  questionOrder    Json
  optionOrder      Json
  markedForReview  Json
  visitedQuestions Json
  warningCount     Int       @default(0)
  version          Int       @default(0)
  clientId         String?
  lastHeartbeatAt  DateTime?
  updatedAt        DateTime  @updatedAt

  practice PracticeSession @relation(fields: [practiceId], references: [id], onDelete: Cascade)
}

model SessionHistoryLog {
  id         String       @id @default(cuid())
  attemptId  String?
  practiceId String?
  event      SessionEvent
  payload    Json?
  createdAt  DateTime     @default(now())

  attempt  Attempt?         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  practice PracticeSession? @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

enum Language {
  EN
  HI
}

enum TranslationStatus {
  MISSING
  DRAFT
  REVIEW
  APPROVED
}

model QuestionTranslation {
  id             String            @id @default(cuid())
  questionId     String
  language       Language
  questionText   String
  explanation    String?
  status         TranslationStatus @default(DRAFT)
  translatedById String?
  reviewedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  question     Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translatedBy User?                       @relation("Translator", fields: [translatedById], references: [id])
  reviewedBy   User?                       @relation("Reviewer", fields: [reviewedById], references: [id])
  options      QuestionOptionTranslation[]
  revisions    TranslationRevision[]

  @@unique([questionId, language])
}

model QuestionOptionTranslation {
  id            String @id @default(cuid())
  translationId String
  optionIndex   Int
  text          String

  translation QuestionTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([translationId, optionIndex])
}

model TranslationRevision {
  id            String   @id @default(cuid())
  translationId String
  version       Int
  questionText  String
  explanation   String?
  optionsJson   Json // Stores snapshot of options
  editedById    String?
  createdAt     DateTime @default(now())

  translation QuestionTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  editedBy    User?               @relation(fields: [editedById], references: [id])
}

// ─── Phase 19: AI Enums ───────────────────────────────────────────────────────

enum AIProvider {
  OPENAI
  GEMINI
  CLAUDE
  OLLAMA
}

enum AIRequestStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AIPromptPurpose {
  STUDY_MATERIAL_GENERATION
  STUDY_SUMMARY
  SIMPLIFY_TEXT
  CONTEXTUAL_EXPLANATION
  VOCABULARY_EXTRACTION
  FLASHCARD_GENERATION
  NOTES_GENERATION
  QUIZ_GENERATION
  MEMORY_TRICK
  EXAM_IMPORTANCE
  QUESTION_GENERATION
  EXPLANATION
  TRANSLATION
  DISTRACTOR_GENERATION
  DUPLICATE_CHECK
  OCR_CLEANUP
  GRAMMAR_FIX
  DIFFICULTY_ESTIMATION
  BLOOM_CLASSIFICATION
  SIMILAR_QUESTION
  QUESTION_IMPROVEMENT
}

// ─── Phase 19: Proctoring Enums ───────────────────────────────────────────────

enum ProctoringType {
  TAB_SWITCH
  FULLSCREEN_EXIT
  COPY
  PASTE
  RIGHT_CLICK
  FACE_ABSENT
  MULTIPLE_FACES
  MICROPHONE_DISABLED
  DEVTOOLS_OPEN
  WINDOW_BLUR
  IDLE_TIMEOUT
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ViolationAction {
  WARN
  PAUSE
  AUTO_SUBMIT
}

// ─── Phase 19: Notification Enums ─────────────────────────────────────────────

enum NotificationType {
  IN_APP
  EMAIL
  SMS
  PUSH
  ANNOUNCEMENT
  OTP
  TEST_REMINDER
  RESULT
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Phase 19: AI Models ──────────────────────────────────────────────────────

model AIProviderConfig {
  id          String     @id @default(cuid())
  provider    AIProvider @unique
  apiKey      String?
  endpoint    String?
  modelName   String?
  enabled     Boolean    @default(true)
  temperature Float      @default(0.7)
  maxTokens   Int        @default(2048)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AIPromptTemplate {
  id        String          @id @default(cuid())
  name      String
  purpose   AIPromptPurpose
  prompt    String
  provider  AIProvider      @default(GEMINI)
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model AIRequestLog {
  id            String          @id @default(cuid())
  userId        String
  provider      AIProvider
  purpose       AIPromptPurpose
  prompt        String
  response      String
  tokenUsage    Int             @default(0)
  executionTime Int             @default(0)
  status        AIRequestStatus
  createdAt     DateTime        @default(now())

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedQuestion AIGeneratedQuestion?

  @@index([userId])
  @@index([purpose])
}

model AIGeneratedQuestion {
  id          String     @id @default(cuid())
  requestId   String     @unique
  question    String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  answer      String
  explanation String?
  difficulty  Difficulty @default(MEDIUM)
  subject     String?
  topic       String?
  approved    Boolean    @default(false)
  imported    Boolean    @default(false)
  createdAt   DateTime   @default(now())

  request AIRequestLog @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ─── Phase 19: Proctoring Models ──────────────────────────────────────────────

model ProctoringViolation {
  id         String            @id @default(cuid())
  attemptId  String
  type       ProctoringType
  screenshot String?
  severity   ViolationSeverity @default(MEDIUM)
  details    String?
  timestamp  DateTime          @default(now())

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

// ─── Phase 19: Notification Model ─────────────────────────────────────────────

model Notification {
  id          String               @id @default(cuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  priority    NotificationPriority @default(LOW)
  read        Boolean              @default(false)
  actionUrl   String?
  scheduledAt DateTime?
  sentAt      DateTime?
  isSent      Boolean              @default(false)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, isSent])
}

// ─── Phase 19: Organization Settings ─────────────────────────────────────────

model SystemSettings {
  id                   String  @id @default("default")
  orgName              String  @default("QuizCraft")
  logo                 String?
  favicon              String?
  primaryColor         String  @default("#2563eb")
  secondaryColor       String  @default("#1e293b")
  timezone             String  @default("Asia/Kolkata")
  defaultLanguage      String  @default("EN")
  defaultTheme         String  @default("dark")
  maintenanceMode      Boolean @default(false)
  maintenanceBanner    String?
  footerText           String?
  supportEmail         String?
  supportPhone         String?
  address              String?
  website              String?
  socialLinks          Json?
  privacyPolicyUrl     String?
  termsUrl             String?
  passwordPolicy       Json?
  emailTemplates       Json?
  smsTemplates         Json?
  otpSettings          Json?
  registrationSettings Json?
  smtpConfig           Json?
  smsProviderConfig    Json?
  storageProvider      String  @default("local")
  storageConfig        Json?
  backupSchedule       String?
  sessionTimeout       Int     @default(3600)
}

// ─── Phase 21: Study Workspace Enums ──────────────────────────────────────────

enum StudyMaterialType {
  BOOK
  EDITORIAL
  CURRENT_AFFAIRS
  ARTICLE
  NOTES
  CUSTOM
  IMPORTED
  AI_GENERATED
}

enum StudyMaterialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VocabularyStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  RED
  PURPLE
}

// ─── Phase 21: Study Workspace Models ─────────────────────────────────────────

model StudyMaterial {
  id                   String              @id @default(cuid())
  title                String
  description          String?
  author               String?
  source               String?
  sourceType           StudyMaterialType   @default(CUSTOM)
  coverImage           String?
  language             Language            @default(EN)
  difficulty           Difficulty          @default(MEDIUM)
  estimatedReadingTime Int                 @default(0)
  tags                 String[]            @default([])
  status               StudyMaterialStatus @default(DRAFT)
  originalFileMetadata Json?
  version              Int                 @default(1)
  parentVersionId      String?
  isPublic             Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  chapters    StudyChapter[]
  collections ReadingCollection[]
}

model StudyChapter {
  id           String   @id @default(cuid())
  materialId   String
  title        String
  chapterOrder Int
  htmlContent  String?  @db.Text
  plainText    String?  @db.Text
  wordCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material   StudyMaterial     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  paragraphs StudyParagraph[]
  progress   ReadingProgress[]

  @@index([materialId])
}

model StudyParagraph {
  id             String  @id @default(cuid())
  chapterId      String
  paragraphOrder Int
  pageNumber     Int?
  htmlContent    String? @db.Text
  plainText      String? @db.Text
  startOffset    Int     @default(0)
  endOffset      Int     @default(0)
  wordCount      Int     @default(0)

  chapter    StudyChapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  highlights StudyHighlight[]
  history    ReadingHistory[]
  progress   ReadingProgress[]

  @@index([chapterId])
}

model ReadingProgress {
  id                    String   @id @default(cuid())
  userId                String
  chapterId             String
  paragraphId           String?
  currentScrollPosition Int      @default(0)
  completionPercentage  Float    @default(0)
  lastOpenedAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   StudyChapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  paragraph StudyParagraph? @relation(fields: [paragraphId], references: [id], onDelete: SetNull)

  @@unique([userId, chapterId])
  @@index([userId])
}

model ReadingHistory {
  id          String   @id @default(cuid())
  userId      String
  paragraphId String
  openedAt    DateTime @default(now())
  timeSpentMs Int      @default(0)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paragraph StudyParagraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paragraphId])
}

model ReadingSession {
  id         String    @id @default(cuid())
  userId     String
  durationMs Int       @default(0)
  pagesRead  Int       @default(0)
  wordsRead  Int       @default(0)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyBookmark {
  id          String   @id @default(cuid())
  userId      String
  chapterId   String
  paragraphId String?
  note        String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chapterId])
}

model StudyHighlight {
  id            String         @id @default(cuid())
  userId        String
  paragraphId   String
  selectedText  String         @db.Text
  startOffset   Int
  endOffset     Int
  color         HighlightColor @default(YELLOW)
  aiExplanation String?        @db.Text
  aiSummary     String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paragraph StudyParagraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  notes     ReadingNote[]

  @@index([userId])
  @@index([paragraphId])
}

model ReadingNote {
  id          String   @id @default(cuid())
  userId      String
  highlightId String?
  content     String   @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlight StudyHighlight? @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VocabularyWord {
  id            String           @id @default(cuid())
  userId        String
  word          String
  pronunciation String?
  ipa           String?
  partOfSpeech  String?
  meaning       String           @db.Text
  hindiMeaning  String?          @db.Text
  synonyms      String[]         @default([])
  antonyms      String[]         @default([])
  examples      String[]         @default([])
  difficulty    Difficulty       @default(MEDIUM)
  status        VocabularyStatus @default(NEW)

  nextRevisionDate   DateTime?
  revisionCount      Int       @default(0)
  lastRevisionResult Boolean?
  lastRevisionAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
  @@index([userId, status])
}

model Flashcard {
  id         String  @id @default(cuid())
  userId     String
  front      String  @db.Text
  back       String  @db.Text
  materialId String?

  nextRevisionDate   DateTime?
  revisionCount      Int       @default(0)
  lastRevisionResult Boolean?
  lastRevisionAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReadingCollection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials StudyMaterial[]

  @@unique([userId, name])
}

model StudyChat {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages StudyChatMessage[]

  @@index([userId, materialId])
}

model StudyChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  chat StudyChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model AICache {
  id          String    @id @default(cuid())
  requestHash String    @unique
  prompt      String    @db.Text
  response    String    @db.Text
  provider    String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model AIGeneratedStudyDraft {
  id            String   @id @default(cuid())
  userId        String
  materialId    String?
  sourceText    String?  @db.Text
  generatedData Json
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Phase 22: QuestionOS Models ──────────────────────────────────────────────

enum PropertyType {
  TEXT
  LONG_TEXT
  RICH_TEXT
  NUMBER
  DATE
  CHECKBOX
  SINGLE_SELECT
  MULTI_SELECT
  RATING
  URL
  JSON
  AI_FIELD
}

model QuestionProperty {
  id           String      @id @default(cuid())
  organizationId String?
  name         String
  slug         String      @unique
  type         PropertyType
  icon         String?
  color        String?
  required     Boolean     @default(false)
  defaultValue Json?
  validation   Json?
  displayOrder Int         @default(0)
  isCore       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  values       QuestionPropertyValue[]
}

model QuestionPropertyValue {
  id           String      @id @default(cuid())
  questionId   String
  propertyId   String
  
  textValue    String?     @db.Text
  numberValue  Float?
  booleanValue Boolean?
  dateValue    DateTime?
  jsonValue    Json?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  question     Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  property     QuestionProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([questionId, propertyId])
  @@index([propertyId])
  @@index([questionId])
}

model QuestionRelation {
  id               String   @id @default(cuid())
  sourceQuestionId String
  targetQuestionId String
  relationType     String   // e.g. "DUPLICATE", "PREREQUISITE", "FOLLOW_UP", "SIMILAR"
  createdAt        DateTime @default(now())

  sourceQuestion Question @relation("SourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  targetQuestion Question @relation("TargetQuestion", fields: [targetQuestionId], references: [id], onDelete: Cascade)

  @@unique([sourceQuestionId, targetQuestionId, relationType])
  @@index([sourceQuestionId])
  @@index([targetQuestionId])
}

model QuestionCollection {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       QuestionCollectionItem[]
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model QuestionCollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  questionId   String
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  collection   QuestionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question     Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, questionId])
  @@index([collectionId])
  @@index([questionId])
}

model QuestionFavorite {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model QuestionRecent {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  openedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model QuestionActivityLog {
  id         String   @id @default(cuid())
  questionId String
  userId     String?
  action     String   // e.g. "CREATED", "EDITED", "PROPERTY_UPDATED", "STATUS_CHANGED"
  details    Json?
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([userId])
}

model QuestionView {
  id             String    @id @default(cuid())
  name           String
  description    String?
  isShared       Boolean   @default(false)
  createdBy      String
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  filters        QuestionViewFilter[]
  sorts          QuestionViewSort[]
  groups         QuestionViewGroup[]
  layout         QuestionViewLayout?
}

model QuestionViewFilter {
  id        String   @id @default(cuid())
  viewId    String
  logic     String   // "AND", "OR"
  field     String?  // Core field or property slug
  operator  String?  // "EQUALS", "CONTAINS", "GREATER_THAN", etc.
  value     Json?    // Serialized value
  parentId  String?  // For nested groups
  order     Int      @default(0)

  view      QuestionView         @relation(fields: [viewId], references: [id], onDelete: Cascade)
  parent    QuestionViewFilter?  @relation("NestedFilters", fields: [parentId], references: [id], onDelete: Cascade)
  children  QuestionViewFilter[] @relation("NestedFilters")

  @@index([viewId])
  @@index([parentId])
}

model QuestionViewSort {
  id        String   @id @default(cuid())
  viewId    String
  field     String   // Core field or property slug
  direction String   // "ASC", "DESC"
  order     Int      @default(0)

  view      QuestionView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@index([viewId])
}

model QuestionViewGroup {
  id        String   @id @default(cuid())
  viewId    String
  field     String   // Core field or property slug
  order     Int      @default(0)

  view      QuestionView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@index([viewId])
}

model QuestionViewLayout {
  id             String   @id @default(cuid())
  viewId         String   @unique
  hiddenColumns  Json     @default("[]") // Array of slugs
  pinnedColumns  Json     @default("[]") // Array of slugs
  columnOrder    Json     @default("[]") // Array of slugs
  columnWidths   Json     @default("{}") // Object mapping slug -> width px
  rowHeight      String   @default("SHORT")
  density        String   @default("COMFORTABLE")

  view           QuestionView @relation(fields: [viewId], references: [id], onDelete: Cascade)
}

model QuestionPresetFilter {
  id          String   @id @default(cuid())
  name        String
  description String?
  filterJson  Json     // Structured JSON for the filter engine
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
