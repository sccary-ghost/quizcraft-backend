generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  attempts  Attempt[]
}

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String?
  duration    Int
  createdAt   DateTime   @default(now())
  attempts    Attempt[]
  questions   Question[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String?  // Optional banaya taaki question bina quiz ke bank mein reh sake
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  subject       String?  // Naya: Filter ke liye
  chapter       String?  // Naya: Filter ke liye
  topic         String?  // Naya: Filter ke liye
  isBank        Boolean  @default(false) // Naya: Master bank identify karne ke liye
  createdAt     DateTime @default(now())
  answers       Answer[]
  quiz          Quiz?    @relation(fields: [quizId], references: [id])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  percentage  Float
  submittedAt DateTime @default(now())
  answers     Answer[]
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Answer {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean
  timeSpent      Int
  attempt        Attempt  @relation(fields: [attemptId], references: [id])
  question       Question @relation(fields: [questionId], references: [id])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}