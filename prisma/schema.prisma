generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  mobileNumber String?   @unique
  isActive     Boolean   @default(true)
  profilePhoto String?
  createdAt    DateTime  @default(now())
  attempts     Attempt[]
}

model OtpVerification {
  id              String   @id @default(cuid())
  mobileNumber    String   @unique
  otpHash         String
  expiresAt       DateTime
  attempts        Int      @default(0)
  resendCount     Int      @default(0)
  lastRequestedAt DateTime @default(now())
}

model Quiz {
  id               String     @id @default(cuid())
  title            String
  description      String?
  duration         Int
  startDate        DateTime?
  endDate          DateTime?
  timezone         String?     @default("Asia/Kolkata")
  status           String      @default("Draft")
  resumeAllowed    Boolean     @default(true)
  availabilityMode String      @default("IMMEDIATE")
  hideUntilStart   Boolean     @default(false)
  autoCloseAfterEnd Boolean    @default(false)
  isDeleted        Boolean    @default(false)
  deletedAt        DateTime?
  updatedAt        DateTime?   @updatedAt
  createdAt        DateTime   @default(now())
  attempts         Attempt[]
  questions        Question[]
  sections         Section[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String?  // Optional banaya taaki question bina quiz ke bank mein reh sake
  sectionId     String?  // Associated section
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  subject       String?  // Naya: Filter ke liye
  chapter       String?  // Naya: Filter ke liye
  topic         String?  // Naya: Filter ke liye
  isBank        Boolean  @default(false) // Naya: Master bank identify karne ke liye
  version       Int      @default(1)
  status        String   @default("Draft")
  tags          String[] @default([])
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  answers       Answer[]
  revisions     QuestionRevision[]
  comments      ReviewComment[]
  quiz          Quiz?    @relation(fields: [quizId], references: [id])
  section       Section? @relation(fields: [sectionId], references: [id])
}

model ReviewComment {
  id          String   @id @default(cuid())
  questionId  String
  comment     String
  authorName  String   @default("Reviewer")
  createdAt   DateTime @default(now())

  questionRelation Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionRevision {
  id            String   @id @default(cuid())
  questionId    String
  version       Int
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  subject       String?
  chapter       String?
  topic         String?
  status        String   @default("Draft")
  tags          String[] @default([])
  createdAt     DateTime @default(now())

  questionRelation Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Section {
  id            String     @id @default(cuid())
  quizId        String
  name          String
  description   String?
  instructions  String?
  order         Int        @default(0)
  marks         Float      @default(4.0)
  negativeMarks Float      @default(1.0)
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Float
  percentage  Float
  submittedAt DateTime @default(now())
  completed   Boolean  @default(true)
  answers     Answer[]
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Answer {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean
  timeSpent      Int
  attempt        Attempt  @relation(fields: [attemptId], references: [id])
  question       Question @relation(fields: [questionId], references: [id])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userId     String?
  userName   String   @default("System")
  ipAddress  String?
  userAgent  String?
  action     String
  target     String?
}