generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  mobileNumber String?   @unique
  isActive     Boolean   @default(true)
  profilePhoto String?
  role         Role      @default(CANDIDATE)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  attempts     Attempt[]
  sessions     Session[]
  goal         UserGoal?
  bookmarks    Bookmark[]
  collections  BookmarkCollection[]
  practiceLogs BookmarkPracticeLog[]
  practiceSessions PracticeSession[]
}

model OtpVerification {
  id              String   @id @default(cuid())
  mobileNumber    String   @unique
  otpHash         String
  expiresAt       DateTime
  attempts        Int      @default(0)
  resendCount     Int      @default(0)
  lastRequestedAt DateTime @default(now())
}

model Quiz {
  id               String     @id @default(cuid())
  title            String
  description      String?
  duration         Int
  startDate        DateTime?
  endDate          DateTime?
  timezone         String?     @default("Asia/Kolkata")
  status           String      @default("Draft")
  resumeAllowed    Boolean     @default(true)
  availabilityMode String      @default("IMMEDIATE")
  hideUntilStart   Boolean     @default(false)
  autoCloseAfterEnd Boolean    @default(false)
  isDeleted        Boolean    @default(false)
  deletedAt        DateTime?
  updatedAt        DateTime?   @updatedAt
  createdAt        DateTime   @default(now())
  isPractice       Boolean    @default(false)
  attempts         Attempt[]
  questions        Question[]
  sections         Section[]
  bookmarks        Bookmark[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String?  // Optional banaya taaki question bina quiz ke bank mein reh sake
  sectionId     String?  // Associated section
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  subject       String?  // Naya: Filter ke liye
  chapter       String?  // Naya: Filter ke liye
  topic         String?  // Naya: Filter ke liye
  isBank        Boolean  @default(false) // Naya: Master bank identify karne ke liye
  version       Int      @default(1)
  status        String   @default("Draft")
  tags          String[] @default([])
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  answers       Answer[]
  revisions     QuestionRevision[]
  comments      ReviewComment[]
  quiz          Quiz?    @relation(fields: [quizId], references: [id])
  section       Section? @relation(fields: [sectionId], references: [id])
  folderId      String?
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  difficulty    Difficulty @default(MEDIUM)
  bookmarks     Bookmark[]
  practiceQuestions PracticeSessionQuestion[]
}

model ReviewComment {
  id          String   @id @default(cuid())
  questionId  String
  comment     String
  authorName  String   @default("Reviewer")
  createdAt   DateTime @default(now())

  questionRelation Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionRevision {
  id            String   @id @default(cuid())
  questionId    String
  version       Int
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  subject       String?
  chapter       String?
  topic         String?
  status        String   @default("Draft")
  tags          String[] @default([])
  createdAt     DateTime @default(now())
  difficulty    Difficulty @default(MEDIUM)

  questionRelation Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Section {
  id            String     @id @default(cuid())
  quizId        String
  name          String
  description   String?
  instructions  String?
  order         Int        @default(0)
  marks         Float      @default(4.0)
  negativeMarks Float      @default(1.0)
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Float
  percentage  Float
  submittedAt DateTime @default(now())
  completed   Boolean  @default(true)
  state       SessionState @default(STARTED)
  answers     Answer[]
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  session     AttemptSession?
  historyLogs SessionHistoryLog[]
}

model Answer {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean
  timeSpent      Int
  attempt        Attempt  @relation(fields: [attemptId], references: [id])
  question       Question @relation(fields: [questionId], references: [id])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userId     String?
  userName   String   @default("System")
  ipAddress  String?
  userAgent  String?
  action     String
  target     String?
}

model Folder {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  parent    Folder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderHierarchy")
  questions Question[]
}

enum Role {
  ADMIN
  CANDIDATE
}

model Media {
  id           String   @id @default(cuid())
  fileName     String   @unique
  originalName String
  mimeType     String
  fileSize     Int
  width        Int
  height       Int
  uploadedBy   String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailOtpVerification {
  id         String   @id @default(cuid())
  email      String   @unique
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model UserGoal {
  id                   String   @id @default(cuid())
  userId               String   @unique
  targetAccuracy       Float    @default(75.0)
  weeklyPracticeGoal   Int      @default(5)
  monthlyTestGoal      Int      @default(15)
  questionsPerWeekGoal Int      @default(100)
  isEnabled            Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BookmarkStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
  ARCHIVED
}

model BookmarkCollection {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int        @default(0)
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  bookmarks   Bookmark[]

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, name])
}

model Bookmark {
  id                   String               @id @default(cuid())
  userId               String
  questionId           String
  quizId               String?              // Originating Test ID
  timesPracticed       Int                  @default(0)
  lastPracticed        DateTime?
  correctCount         Int                  @default(0)
  incorrectCount       Int                  @default(0)
  
  // Spaced Repetition / Revision Scheduling
  nextRevisionDate     DateTime?
  revisionCount        Int                  @default(0)
  lastRevisionResult   Boolean?
  lastRevisionAt       DateTime?
  
  status               BookmarkStatus       @default(NEW)

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  collections          BookmarkCollection[]

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  question             Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quiz                 Quiz?                @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@unique([userId, questionId])
}

model BookmarkPracticeLog {
  id             String   @id @default(cuid())
  userId         String
  questionsCount Int
  correctCount   Int
  score          Float
  timeSpent      Int
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PracticeSource {
  BOOKMARKS
  INCORRECT
  SKIPPED
  WEAK_SUBJECTS
  WEAK_CHAPTERS
  WEAK_TOPICS
  MIXED
  CUSTOM
}

model PracticeSession {
  id             String                    @id @default(cuid())
  userId         String
  source         PracticeSource
  filters        Json?
  adaptive       Json?
  options        Json?                     // For shuffle, timer, instant feedback, explanation, negative marking, etc.
  createdAt      DateTime                  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  currentIndex   Int                       @default(0)
  totalQuestions Int
  score          Float?
  accuracy       Float?
  timeSpent      Int                       @default(0)
  state          SessionState              @default(STARTED)

  questions      PracticeSessionQuestion[]
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot       PracticeSessionSnapshot?
  historyLogs    SessionHistoryLog[]
}

model PracticeSessionQuestion {
  id                String          @id @default(cuid())
  practiceSessionId String
  questionId        String
  selectedAnswer    String?         // Track response selection
  isCorrect         Boolean?
  timeSpent         Int             @default(0)
  order             Int             @default(0)

  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceSessionId, questionId])
}

enum SessionState {
  CREATED
  STARTED
  ACTIVE
  OFFLINE
  PAUSED
  RESUMED
  LOCKED
  SYNC_CONFLICT
  COMPLETED
  AUTO_SUBMITTED
  EXPIRED
}

enum SessionEvent {
  STARTED
  RESUMED
  AUTO_SAVE
  HEARTBEAT
  OFFLINE
  ONLINE
  CLAIMED
  AUTO_SUBMITTED
  COMPLETED
  EXPIRED
}

model AttemptSession {
  id               String       @id @default(cuid())
  attemptId        String       @unique
  currentIndex     Int          @default(0)
  currentSectionId String?
  questionOrder    Json         // Shuffled array of question IDs
  optionOrder      Json         // Shuffled options map per question
  markedForReview  Json         // Array of marked question IDs
  visitedQuestions Json         // Array of visited question IDs
  warningCount     Int          @default(0)
  version          Int          @default(0)
  
  lastHeartbeatAt  DateTime?
  clientId         String?      // Client active tab token
  updatedAt        DateTime     @updatedAt

  attempt          Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model PracticeSessionSnapshot {
  id               String          @id @default(cuid())
  practiceId       String          @unique
  currentIndex     Int             @default(0)
  currentSectionId String?
  questionOrder    Json
  optionOrder      Json
  markedForReview  Json
  visitedQuestions Json
  warningCount     Int             @default(0)
  version          Int             @default(0)
  clientId         String?
  lastHeartbeatAt  DateTime?
  updatedAt        DateTime        @updatedAt

  practice         PracticeSession @relation(fields: [practiceId], references: [id], onDelete: Cascade)
}

model SessionHistoryLog {
  id         String           @id @default(cuid())
  attemptId  String?
  practiceId String?
  event      SessionEvent
  payload    Json?
  createdAt  DateTime         @default(now())

  attempt    Attempt?         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  practice   PracticeSession? @relation(fields: [practiceId], references: [id], onDelete: Cascade)
}